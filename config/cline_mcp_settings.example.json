{
  "mcpServers": {
    "ghidra": {
      "command": "<PYTHON_EXE>",
      "args": ["<GHIDRA_MCP_ROOT>/server.py"],
      "env": {
        "GHIDRA_MCP_INSTALL_DIR": "<GHIDRA_INSTALL>",
        "GHIDRA_MCP_JAVA_HOME": "<JDK_HOME>",
        "GHIDRA_MCP_PROJECTS": "<GHIDRA_MCP_ROOT>/projects",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      },
      "disabled": false,
      "autoApprove": [
        "ghidra_environment",
        "ghidra_session_status",
        "ghidra_list_projects",
        "ghidra_list_programs",
        "ghidra_current_program",
        "ghidra_list_functions",
        "ghidra_function_details",
        "ghidra_decompile_function",
        "ghidra_search_symbols",
        "ghidra_call_graph",
        "ghidra_disassemble",
        "ghidra_xrefs",
        "ghidra_list_strings",
        "ghidra_list_imports",
        "ghidra_list_entry_points",
        "ghidra_read_bytes",
        "ghidra_search_bytes",
        "ghidra_list_data_types",
        "ghidra_list_memory_blocks"
      ],
      "timeout": 900
    }
  }
}
